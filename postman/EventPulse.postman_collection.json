{
  "info": {
    "_postman_id": "e3090810-1301-237e-vent-pulse0001",
    "name": "EYOUTH-30908101301237-EventPulse",
    "description": "REST collection for EventPulse. Set base_url and auth_token in the environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "auth_token", "value": "" },
    { "key": "event_id", "value": "" },
    { "key": "category_id", "value": "" },
    { "key": "registration_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register attendee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('auth_token', body.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attendee@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.token) pm.collectionVariables.set('auth_token', body.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventpulse.local\",\n  \"password\": \"AdminPass123\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events?page=1&limit=10&sort=date"
          }
        },
        {
          "name": "Filter events",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events?city=Cairo&startDate=2026-01-01T00:00:00.000Z&endDate=2026-12-31T23:59:59.000Z"
          }
        },
        {
          "name": "Search events",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events?search=tech&sort=popularity"
          }
        },
        {
          "name": "Get event by id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events/{{event_id}}"
          }
        },
        {
          "name": "Create event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Campus Hack Night\",\n  \"description\": \"Build something overnight\",\n  \"date\": \"2026-09-18T17:00:00.000Z\",\n  \"city\": \"Cairo\",\n  \"capacity\": 60,\n  \"category\": \"{{category_id}}\"\n}"
            },
            "url": "{{base_url}}/events"
          }
        },
        {
          "name": "Update event",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"capacity\": 80\n}"
            },
            "url": "{{base_url}}/events/{{event_id}}"
          }
        },
        {
          "name": "Delete event",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": "{{base_url}}/events/{{event_id}}"
          }
        },
        {
          "name": "List announcements",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/events/{{event_id}}/announcements"
          }
        }
      ]
    },
    {
      "name": "Registrations",
      "item": [
        {
          "name": "Register for event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\"\n}"
            },
            "url": "{{base_url}}/registrations"
          }
        },
        {
          "name": "My registrations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": "{{base_url}}/registrations"
          }
        },
        {
          "name": "Cancel registration",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "url": "{{base_url}}/registrations/{{registration_id}}"
          }
        }
      ]
    }
  ]
}
